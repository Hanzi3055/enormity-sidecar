# Enormity Sidecar production configuration example.
# Copy to .env and fill values on the deployment host. Do not commit real secrets.

NODE_ENV=production
PORT=3100
WS_PORT=3101
# Use 0.0.0.0 only inside a private Docker network. Host publication remains
# loopback-bound by Compose.
SIDECAR_BIND_HOST=127.0.0.1

# Security
JWT_SECRET=<strong-random-jwt-signing-secret>
ENORMITY_API_KEYS=<comma-separated-api-keys>
# Nexus Core stays read-only until each typed command domain is certified.
ENORMITY_BACKGROUND_WRITES_ENABLED=0

# MySQL / CloudPatrol database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=<database-user>
MYSQL_PASSWORD=<database-password>
MYSQL_DATABASE=cloudpatrol

# Dedicated least-privilege Nexus identities. Passwords are Docker secrets;
# never place their values in this file. Grant templates live under migrations/.
NEXUS_DB_IDENTITY_STRICT=1
NEXUS_QUERY_MYSQL_USER=nexus_query
NEXUS_QUERY_MYSQL_PASSWORD_FILE=/run/secrets/nexus_query_mysql_password
NEXUS_COMMAND_MYSQL_USER=nexus_command
NEXUS_COMMAND_MYSQL_PASSWORD_FILE=/run/secrets/nexus_command_mysql_password
NEXUS_IDENTITY_MYSQL_USER=nexus_identity
NEXUS_IDENTITY_MYSQL_PASSWORD_FILE=/run/secrets/nexus_identity_mysql_password
NEXUS_BIOMETRIC_MYSQL_USER=nexus_biometric
NEXUS_BIOMETRIC_MYSQL_PASSWORD_FILE=/run/secrets/nexus_biometric_mysql_password

# Per-domain source modes: compare, direct, or oem. Mutations never fall back.
NEXUS_DOMAIN_SOURCE_LOCATIONS=direct
NEXUS_DOMAIN_SOURCE_ASSISTANT_METRICS=direct

# Redis cache
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=<optional-redis-password>

# Optional Telegram SOS escalation notifications
TELEGRAM_BOT_TOKEN=<optional-telegram-bot-token>
TELEGRAM_CHAT_ID=<optional-telegram-chat-id>
