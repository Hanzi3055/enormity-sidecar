# Enormity Sidecar production configuration example.
# Copy to .env and fill values on the deployment host. Do not commit real secrets.

NODE_ENV=production
PORT=3100
WS_PORT=3101
# Use 0.0.0.0 only inside a private Docker network. Host publication remains
# loopback-bound by Compose.
SIDECAR_BIND_HOST=127.0.0.1

# Security
JWT_SECRET=<strong-random-jwt-signing-secret>
ENORMITY_API_KEYS=<comma-separated-api-keys>
# Set to 0 for a read-only disposable QA instance. Production defaults to 1 to
# preserve the existing escalation, audit-retention, and archive automation.
ENORMITY_BACKGROUND_WRITES_ENABLED=1

# MySQL / CloudPatrol database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=<database-user>
MYSQL_PASSWORD=<database-password>
MYSQL_DATABASE=cloudpatrol

# Redis cache
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=<optional-redis-password>

# Optional Telegram SOS escalation notifications
TELEGRAM_BOT_TOKEN=<optional-telegram-bot-token>
TELEGRAM_CHAT_ID=<optional-telegram-chat-id>
